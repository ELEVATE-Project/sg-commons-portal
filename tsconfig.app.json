{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,

    "baseUrl": "src",
    "paths": {
      "store": ["store"],
      "store/*": ["store/*"],
      "hooks/*": ["hooks/*"],
      "api/*": ["api/*"],
      "configure": ["configure"],
      "utils/*": ["utils/*"],
      "constants/*": ["constants/*"],
      "services/*": ["services/*"],
      "components/*": ["components/*"],
      "pages/*": ["pages/*"],
      "assets/*": ["assets/*"]
    }
  },
  "include": ["src"]
}